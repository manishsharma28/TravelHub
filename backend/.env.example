# Zoho Mail SMTP for info@unmappedtrips.com (India data center).
# Copy this file to backend/.env and set SMTP_PASS to the mailbox password.
# If Zoho asks for an application-specific password, use that instead.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@unmappedtrips.com
SMTP_PASS=

ENQUIRY_EMAIL_TO=info@unmappedtrips.com
ENQUIRY_EMAIL_FROM=info@unmappedtrips.com
