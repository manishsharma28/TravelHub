# Leave EMPTY in production. The Amplify rewrite forwards same-origin
# "/api/*" requests to the Lambda, which avoids CORS entirely.
VITE_API_BASE_URL=

# Only needed if you point the site at an API on a different host,
# e.g. a deployed Lambda Function URL while running the UI locally:
# VITE_API_BASE_URL=https://abc123.lambda-url.ap-south-1.on.aws
